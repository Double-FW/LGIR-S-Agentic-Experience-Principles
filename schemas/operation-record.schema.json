{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LGIR+S illustrative operation record, not an MCP or OpenAPI payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "task_id",
    "synthetic",
    "execution_status",
    "effect_status",
    "cancellation_status",
    "retry_policy",
    "recovery_class",
    "can_undo",
    "evidence",
    "human_message",
    "scope_ref",
    "model_version",
    "tool_contract_version",
    "limitations"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "execution_status": {
      "enum": [
        "planned",
        "running",
        "waiting_external",
        "cancellation_requested",
        "stopped_before_commit",
        "outcome_unknown",
        "partially_completed",
        "reconciling",
        "completed",
        "failed_no_effect",
        "compensated",
        "closed_with_residual_effect"
      ]
    },
    "effect_status": {
      "enum": [
        "none",
        "unknown",
        "partial",
        "committed",
        "compensated",
        "residual"
      ]
    },
    "cancellation_status": {
      "enum": [
        "not_requested",
        "requested",
        "acknowledged",
        "new_work_stopped",
        "confirmed_before_commit",
        "not_supported"
      ]
    },
    "retry_policy": {
      "enum": [
        "not_attempted",
        "blocked_pending_reconciliation",
        "allowed_with_verified_idempotency",
        "not_applicable"
      ]
    },
    "recovery_class": {
      "enum": [
        "reversible",
        "compensatable",
        "irreversible",
        "unknown",
        "not_applicable"
      ]
    },
    "can_undo": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_message": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "tool_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "outcome_unknown"
          }
        }
      },
      "then": {
        "properties": {
          "effect_status": {
            "const": "unknown"
          },
          "retry_policy": {
            "const": "blocked_pending_reconciliation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "effect_status": {
            "const": "committed"
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "failed_no_effect",
              "stopped_before_commit"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "effect_status": {
            "const": "none"
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recovery_class": {
            "enum": [
              "irreversible",
              "unknown",
              "not_applicable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "can_undo": {
            "const": false
          }
        }
      }
    }
  ]
}
